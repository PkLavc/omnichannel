POSTGRES_PASSWORD=change-me
# Modelo de configuracao privada. O menu cria omnichannel-data/config/platform.env.
# Nao copie este arquivo para a raiz do repositorio.
GATEWAY_ENCRYPTION_KEY=CHANGEME
ADMIN_TOKEN=replace-with-a-long-random-admin-token
# Ponte opcional de login único. Deixe vazia para usar somente contas locais.
NEXUS_SSO_REDEEM_URL=
NEXUS_SSO_REDEEM_TIMEOUT_MS=5000
NEXUS_SSO_ISSUER=https://sso.example.com
NEXUS_SSO_AUDIENCE=omnichannel-admin
ADMIN_ALLOWED_ORIGINS=
# Credencial mestra exclusiva do backend. Integrações recebem apenas o token derivado de cada empresa.
COMMERCIAL_EVENTS_TOKEN=replace-with-a-backend-commercial-events-master-secret
N8N_ENCRYPTION_KEY=replace-with-a-long-random-n8n-key
EMBEDDING_PROVIDER=local
# Ollama é opcional. Deixe comentado no ambiente padrão.
# OLLAMA_URL=http://host.docker.internal:11434
CHATWOOT_SECRET_KEY_BASE=replace-with-a-long-random-secret
CHATWOOT_FRONTEND_URL=http://localhost:3000
CHATWOOT_ADMIN_EMAIL=admin@example.local
CHATWOOT_ADMIN_PASSWORD=choose-a-strong-local-password
# Login Google opcional. Mantenha credenciais e usuarios autorizados somente
# em omnichannel-data/config/platform.env.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=
